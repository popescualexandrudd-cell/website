# HTTPS with automatic Let's Encrypt certificates, compression, long cache for static files,
# uploaded images and videos served straight from the volume, www → apex redirect.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Forms and photos stay small; only the admin's video upload may bring a large file.
	@notVideoUpload not path /api/admin/media/video
	request_body @notVideoUpload {
		max_size 12MB
	}
	@videoUpload path /api/admin/media/video
	request_body @videoUpload {
		max_size 520MB
	}

	# Images and videos uploaded from the admin (unique names, never change). Videos are
	# served with byte ranges, so they can be seeked and play in Safari. Hidden folders (videos
	# waiting for conversion) are never served.
	handle /media/* {
		@hiddenMedia path_regexp hiddenMedia ^/media/(.*/)?\.
		respond @hiddenMedia 404
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
	}

	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Host {host}
		}
	}

	header {
		-Server
		-X-Powered-By
		-Via
	}

	# No access log: visitors' IP addresses are not stored (errors still go to `docker compose logs caddy`).
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Optional sites (e.g. Umami statistics), see docker/caddy/umami.caddy.example.
import /etc/caddy/sites/*.caddy
