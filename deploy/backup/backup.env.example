# The backup's secrets (ADR-0016). Copy to /etc/jungle/backup.env on the server (chmod 600) and
# keep the two keys ALSO outside the server, in two safe places known to the owner: without
# them a backup cannot be read, not even by us. Make a key: `openssl rand -base64 48`.

# The copy kept on the server.
PGBACKREST_REPO1_CIPHER_PASS=

# The copy outside the club (Q73): an S3-compatible bucket in the EU. Uncomment and fill in
# when chosen; until then only the copy on the server exists (a disk failure would lose it).
#PGBACKREST_REPO2_TYPE=s3
#PGBACKREST_REPO2_PATH=/jungle
#PGBACKREST_REPO2_S3_BUCKET=
#PGBACKREST_REPO2_S3_ENDPOINT=
#PGBACKREST_REPO2_S3_REGION=
#PGBACKREST_REPO2_S3_KEY=
#PGBACKREST_REPO2_S3_KEY_SECRET=
#PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
#PGBACKREST_REPO2_CIPHER_PASS=
#PGBACKREST_REPO2_RETENTION_FULL=8
