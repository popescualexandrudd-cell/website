# The production settings (ADR-0015). Copy to /etc/jungle/prod.env on the server (readable only
# by root: `chmod 600`), fill in every empty value, never commit the real file (invariant 10).
# Long random values: `openssl rand -base64 48`.

# ---- the release and the domain
JUNGLE_ENV=prod
# The version being run (a git tag, e.g. v1.0.0); deploy/scripts/update sets it.
JUNGLE_VERSION=
# The club's domain (Q39), without www: the subdomains come from it (§4.6).
DOMAIN=example.invalid
# For the TLS certificates (Let's Encrypt): the club's technical contact.
ACME_EMAIL=
# Extra Caddy global options; empty in production. Staging: acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_OPTIONS=
# true only when the site may appear in search engines (the full site published).
SITE_INDEXABLE=false
# The club's own certificate authority for the devices (deploy/scripts/devices-ca, ADR-0012).
DEVICES_CA_FILE=/etc/jungle/devices-ca.pem

# ---- the database (the address is built by the compose file)
POSTGRES_PASSWORD=
# The backup's secrets, in a file of their own (deploy/backup/backup.env.example).
BACKUP_ENV_FILE=/etc/jungle/backup.env

# ---- the backend
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DEVICE_COMMAND_KEY=
DJANGO_ALLOWED_HOSTS=api.example.invalid,admin.example.invalid,device.example.invalid
SESSION_COOKIE_DOMAIN=.example.invalid
CSRF_COOKIE_DOMAIN=.example.invalid
CSRF_TRUSTED_ORIGINS=https://www.example.invalid,https://admin.example.invalid
CORS_ALLOWED_ORIGINS=https://www.example.invalid,https://admin.example.invalid
WEB_BASE_URL=https://www.example.invalid
# The website refreshes at once after a change in the panel (the same secret on both sides).
WEB_REVALIDATE_URL=http://web:3000/api/revalidate
WEB_REVALIDATE_SECRET=
TRUSTED_PROXY_COUNT=1
EMERGENCY_ADMIN_ENABLED=true
API_DOCS_ENABLED=false
LOG_LEVEL=INFO

# ---- email (the provider, Q24)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Jungle Padel <no-reply@example.invalid>

# ---- the devices (ADR-0012, ADR-0013)
DEVICE_CERT_HEADER=HTTP_X_CLIENT_CERT_SHA256
DEVICE_MTLS_REQUIRED=true
BRIDGE_MESSAGE_WINDOW_SECONDS=120
KIOSK_ALLOW_LOOPBACK=false
FISCAL_PRINTER=simulator

# ---- Wallet (Q24; the steps: docs/08-deploy-si-mentenanta/02-ghid-apple-google-wallet.md)
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_FILE=/run/secrets/apple-pass-cert.pem
APPLE_PASS_KEY_FILE=/run/secrets/apple-pass-key.pem
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERT_FILE=/run/secrets/apple-wwdr-g4.pem
APPLE_WALLET_WEB_SERVICE_URL=https://api.example.invalid/api/v1/wallet/apple
APPLE_APNS_HOST=https://api.push.apple.com
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=/run/secrets/google-wallet-service-account.json

# ---- push notifications (`manage.py vapid_keys`, once)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.invalid

# ---- the AI (ADR-0019): without a key it stays off
AI_API_KEY=
AI_MODEL=
AI_FAKE=false

# ---- monitoring (ADR-0017)
# Uptime Kuma "push" address: the scheduler calls it after every round in which all jobs worked.
SCHEDULER_HEARTBEAT_URL=
# The backups (ADR-0016): true on the production server (the daily check raises the alarm when a
# backup or the monthly restore test is missing); the heartbeat after each backup that worked.
BACKUPS_EXPECTED=true
BACKUP_HEARTBEAT_URL=
# Cookie-free statistics (Umami), only after the visitor's consent on the site:
# UMAMI_SRC=https://statistici.<domain>/script.js and the website's id from Umami.
UMAMI_SRC=
UMAMI_WEBSITE_ID=
# The club's GlitchTip (erori.<domain>): the backend's errors and the ones the browsers and the
# devices report (POST /api/v1/client-errors). Empty: errors only in the logs.
SENTRY_DSN=
# Logs: json (searchable) in production.
LOG_FORMAT=json
# The server's disk: an alert above this share (the scheduler watches the backups' volume).
DISK_ALERT_PERCENT=85
# The monitoring services (docker compose --profile monitoring up -d): their own secrets.
MONITORING_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
UMAMI_APP_SECRET=
