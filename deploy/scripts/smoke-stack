#!/usr/bin/env python3
"""The whole production stack on one machine (ADR-0015), started from deploy/compose/prod exactly
as on the server, with throw-away secrets, a throw-away device authority and local certificates
(`CADDY_OPTIONS=local_certs`), then checked from outside through the proxy:

- the database is migrated and seeded by `migrate`, then the backend, the live channel, the
  scheduler, the website and the proxy run;
- www answers with the website, api with the API (health), admin with the panel;
- a device site refuses a visitor without the club's certificate and accepts one with it;
- Django's deployment checks pass inside the backend, and the scheduler has done a round;
- a full backup is taken with pgBackRest and the restore test brings it back in a throw-away
  container, both reported to the backend (deploy/scripts/backup, ADR-0016);
- the club's busiest evening (tests/load/club.js, Stage 15) with the full site on and a league
  season open, when k6 is given (`K6=<path to k6>`; `LOAD_VISITORS`, `LOAD_HOLD`, default 50
  visitors for 30 s);
- a version update and the way back (deploy/scripts/update, deploy/scripts/rollback), from a
  copy of the repository with two versions, the second adding a database migration: the
  rollback brings the database back to the moment before the update (point in time);
- the database emptied before the opening (deploy/scripts/reset-before-launch, Stage 16), then
  a new backup.

Everything is removed at the end (containers and volumes). Needs Docker with Compose, `openssl`,
`curl`, and the ports 80 and 443 free.
    deploy/scripts/smoke-stack                # builds the images (tag `smoke`)
    SMOKE_BUILD_ARGS="--build-arg PYTHON_IMAGE=… --build-arg NODE_IMAGE=…" deploy/scripts/smoke-stack
"""

from __future__ import annotations

import base64
import json
import os
import secrets
import shlex
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
COMPOSE = ROOT / "deploy" / "compose" / "prod" / "compose.yaml"
DOMAIN = "club.test"
PROJECT = "jungle-smoke"


def sh(*cmd: str, check: bool = True, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=check, capture_output=True, text=True, env=env)


def ca(folder: Path) -> tuple[Path, Path, Path]:
    """The club's authority and one device certificate signed by it."""
    ca_key, ca_pem = folder / "ca.key", folder / "devices-ca.pem"
    sh("openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
       "-nodes", "-keyout", str(ca_key), "-out", str(ca_pem), "-days", "2", "-subj", "/CN=smoke CA")
    key, csr, pem = folder / "device.key", folder / "device.csr", folder / "device.pem"
    sh("openssl", "req", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
       "-keyout", str(key), "-out", str(csr), "-subj", "/CN=smoke device")
    ext = folder / "device.ext"
    ext.write_text("extendedKeyUsage=clientAuth\n")
    sh("openssl", "x509", "-req", "-in", str(csr), "-CA", str(ca_pem), "-CAkey", str(ca_key),
       "-CAcreateserial", "-out", str(pem), "-days", "2", "-extfile", str(ext))
    return ca_pem, key, pem


def env_file(folder: Path, ca_pem: Path) -> Path:
    def secret() -> str:
        return secrets.token_urlsafe(48)

    values = {
        "JUNGLE_ENV": "prod",
        "JUNGLE_VERSION": "smoke",
        "DOMAIN": DOMAIN,
        "ACME_EMAIL": "smoke@example.test",
        "CADDY_OPTIONS": "local_certs",
        "DEVICES_CA_FILE": str(ca_pem),
        "POSTGRES_PASSWORD": secret(),
        "DJANGO_SECRET_KEY": secret(),
        "FIELD_ENCRYPTION_KEY": secret(),
        "DEVICE_COMMAND_KEY": base64.b64encode(os.urandom(32)).decode(),
        "DJANGO_ALLOWED_HOSTS": f"api.{DOMAIN},admin.{DOMAIN},device.{DOMAIN}",
        "SESSION_COOKIE_DOMAIN": f".{DOMAIN}",
        "CSRF_COOKIE_DOMAIN": f".{DOMAIN}",
        "CSRF_TRUSTED_ORIGINS": f"https://www.{DOMAIN},https://admin.{DOMAIN}",
        "CORS_ALLOWED_ORIGINS": f"https://www.{DOMAIN},https://admin.{DOMAIN}",
        "WEB_BASE_URL": f"https://www.{DOMAIN}",
        "WEB_REVALIDATE_URL": "http://web:3000/api/revalidate",
        "WEB_REVALIDATE_SECRET": secret(),
        "TRUSTED_PROXY_COUNT": "1",
        "EMAIL_BACKEND": "django.core.mail.backends.locmem.EmailBackend",
        "DEVICE_MTLS_REQUIRED": "true",
        "FISCAL_PRINTER": "simulator",
    }
    path = folder / "smoke.env"
    path.write_text("".join(f"{k}={v}\n" for k, v in values.items()))
    backup = folder / "backup.env"
    backup.write_text(f"PGBACKREST_REPO1_CIPHER_PASS={secret()}\n")
    with path.open("a") as more:
        more.write(f"BACKUP_ENV_FILE={backup}\n")
    return path


def curl(host: str, path: str, *, cert: tuple[Path, Path] | None = None) -> tuple[int, str]:
    cmd = ["curl", "-sk", "--noproxy", "*", "--max-time", "15", "-o", "-", "-w", "\n%{http_code}",
           "--resolve", f"{host}:443:127.0.0.1", f"https://{host}{path}"]
    if cert:
        cmd += ["--key", str(cert[0]), "--cert", str(cert[1])]
    done = sh(*cmd, check=False)
    if done.returncode != 0:
        return 0, ""
    body, _, code = done.stdout.rpartition("\n")
    return int(code), body


MIGRATION = """from django.db import migrations


class Migration(migrations.Migration):
    dependencies = [("scheduler", "{previous}")]
    operations = [
        migrations.RunSQL("CREATE TABLE smoke_marker (id int)", "DROP TABLE smoke_marker"),
    ]
"""


def update_and_rollback(folder: Path, envf: Path, check: Any) -> None:
    print("update and rollback", flush=True)
    clone = folder / "clone"
    sh("git", "clone", "-q", str(ROOT), str(clone))
    git = ["git", "-C", str(clone), "-c", "user.name=smoke", "-c", "user.email=smoke@example.test"]
    sh(*git, "tag", "v-smoke-1")
    migrations = clone / "apps" / "backend" / "jungle" / "scheduler" / "migrations"
    previous = sorted(p.stem for p in migrations.glob("0*.py"))[-1]
    (migrations / "9999_smoke.py").write_text(MIGRATION.format(previous=previous))
    sh(*git, "add", "-A")
    sh(*git, "commit", "-q", "-m", "test: a release with a migration")
    sh(*git, "tag", "v-smoke-2")
    state = folder / "state"
    state.mkdir()
    run_env = {
        **os.environ,
        "JUNGLE_ENV_FILE": str(envf),
        "JUNGLE_STATE_DIR": str(state),
        "COMPOSE_PROJECT": PROJECT,
        "JUNGLE_BUILD_ARGS": os.environ.get("SMOKE_BUILD_ARGS", ""),
    }
    compose = ["docker", "compose", "-p", PROJECT, "-f", str(clone / "deploy/compose/prod/compose.yaml"),
               "--env-file", str(envf)]

    def script(name: str, *args: str, answer: str = "") -> bool:
        done = subprocess.run([str(clone / "deploy" / "scripts" / name), *args], input=answer,
                              capture_output=True, text=True, env=run_env)
        if done.returncode:
            print(done.stdout[-3000:], done.stderr[-3000:], file=sys.stderr)
        return done.returncode == 0

    def sql(query: str) -> str:
        done = subprocess.run([*compose, "exec", "-T", "db", "psql", "-U", "jungle", "-d", "jungle",
                               "-Atc", query], capture_output=True, text=True, env=run_env)
        return done.stdout.strip()

    check(script("update", "v-smoke-1"), "update to v-smoke-1 (no database change)")
    check(script("update", "v-smoke-2"), "update to v-smoke-2 (a new migration)")
    check(sql("SELECT to_regclass('smoke_marker') IS NOT NULL") == "t", "the migration applied")
    sql("INSERT INTO scheduler_jobrun (job, started_at, ok, output) VALUES ('after-update', now(), true, '')")
    check(script("rollback", answer="DA\n"), "rollback with the database brought back")
    check(sql("SELECT to_regclass('smoke_marker') IS NULL") == "t", "the migration undone")
    check(sql("SELECT count(*) FROM scheduler_jobrun WHERE job = 'after-update'") == "0",
          "what was saved after the update is gone (point in time)")
    check(sql("SELECT count(*) FROM scheduler_jobrun WHERE job = 'backup.full' AND ok") != "0",
          "what was saved before the update is there")
    health = subprocess.run([*compose, "exec", "-T", "backend", "python", "healthcheck.py"],
                            capture_output=True, text=True, env=run_env)
    check(health.returncode == 0, "the backend answers after the rollback")

    print("the reset before the opening", flush=True)
    check(not script("reset-before-launch", answer="wrong.test\n"), "reset: refused without the domain")
    check(sql("SELECT count(*) FROM scheduler_jobrun WHERE job = 'backup.full' AND ok") != "0",
          "reset: nothing deleted when refused")
    check(script("reset-before-launch", answer=f"{DOMAIN}\n"), "reset: done with the domain typed")
    check(sql("SELECT count(*) FROM scheduler_jobrun WHERE job LIKE 'backup.%'") == "0",
          "reset: the database starts empty")
    check(sql("SELECT count(*) FROM locations_location") != "0", "reset: the initial data is there")
    check(script("backup", "full"), "reset: a new backup after it")


SEASON = """
from datetime import timedelta
from jungle.core import clock
from jungle.league.models import LeagueSeason, SeasonStatus
from jungle.locations.models import Location
now = clock.now()
LeagueSeason.objects.create(location=Location.objects.get(slug="jungle-padel"), number=0,
    name="Sezonul 0 (test de încărcare)", starts_at=now - timedelta(days=1),
    ends_at=now + timedelta(days=90), status=SeasonStatus.ACTIVE, is_calibration=True)
"""


def load(compose: list[str], env: dict[str, str], check: Any) -> None:
    """The busiest evening (tests/load/club.js) against the stack, as on the server."""
    k6 = os.environ.get("K6")
    if not k6:
        print("the load test: skipped (no K6)", flush=True)
        return
    print("the load test", flush=True)
    for command in (
        ["set_flag", "full_site", "on", "--reason", "smoke: the load test"],
        ["shell", "-c", SEASON],
    ):
        done = subprocess.run([*compose, "exec", "-T", "backend", "python", "manage.py", *command],
                              capture_output=True, text=True, env=env)
        check(done.returncode == 0, f"load: {command[0]}")
        if done.returncode:
            print(done.stdout[-2000:], done.stderr[-2000:], file=sys.stderr)
    for _ in range(30):
        if curl(f"www.{DOMAIN}", "/ro/liga")[0] == 200:
            break
        time.sleep(2)
    check(curl(f"www.{DOMAIN}", "/ro/liga")[0] == 200, "load: the full site is on")
    run = subprocess.run(
        [k6, "run", "--quiet", str(ROOT / "tests" / "load" / "club.js")],
        env={**os.environ, "DOMAIN": DOMAIN, "RESOLVE": "127.0.0.1", "NO_PROXY": "*",
             "VISITORS": os.environ.get("LOAD_VISITORS", "50"),
             "HOLD": os.environ.get("LOAD_HOLD", "30s")},
        capture_output=True, text=True)
    print(run.stdout[-4000:], flush=True)
    check(run.returncode == 0, "load: the thresholds held (tests/load/club.js)")
    if run.returncode:
        print(run.stderr[-3000:], file=sys.stderr)


def main() -> int:
    failures: list[str] = []

    def check(ok: bool, what: str) -> None:
        print(("  ok   " if ok else "  FAIL ") + what, flush=True)
        if not ok:
            failures.append(what)

    with tempfile.TemporaryDirectory() as tmp:
        folder = Path(tmp)
        ca_pem, device_key, device_pem = ca(folder)
        envf = env_file(folder, ca_pem)
        env = {**os.environ, **dict(line.split("=", 1) for line in envf.read_text().splitlines()),
               "JUNGLE_ENV_FILE": str(envf)}
        compose = ["docker", "compose", "-p", PROJECT, "-f", str(COMPOSE), "--env-file", str(envf)]
        build_args = shlex.split(os.environ.get("SMOKE_BUILD_ARGS", ""))
        finished = False
        try:
            print("building and starting the stack…", flush=True)
            for service in ("db", "migrate", "web", "proxy"):
                subprocess.run([*compose, "build", *build_args, service], check=True, env=env)
            subprocess.run([*compose, "up", "-d"], check=True, env=env)
            for _ in range(90):
                if curl(f"api.{DOMAIN}", "/api/v1/health")[0] == 200:
                    break
                time.sleep(2)
            print("through the proxy", flush=True)
            code, body = curl(f"api.{DOMAIN}", "/api/v1/health")
            check(code == 200, f"api: health ({code})")
            code, body = curl(f"www.{DOMAIN}", "/ro")
            check(code == 200 and "<html" in body.lower(), f"www: the website ({code})")
            code, body = curl(f"admin.{DOMAIN}", "/")
            check(code == 200 and '<div id="root">' in body, f"admin: the panel ({code})")
            code, body = curl(f"admin.{DOMAIN}", "/api/v1/auth/session")
            check(code in (200, 401), f"admin: the API on the same origin ({code})")
            check(curl(f"kiosk-liga.{DOMAIN}", "/")[0] == 0, "kiosk-liga: refused without a certificate")
            code, body = curl(f"kiosk-liga.{DOMAIN}", "/", cert=(device_key, device_pem))
            check(code == 200, f"kiosk-liga: the app with the club's certificate ({code})")
            code, body = curl(f"device.{DOMAIN}", "/api/v1/health", cert=(device_key, device_pem))
            check(code == 200, f"device: the API with the club's certificate ({code})")
            print("inside", flush=True)
            deploy_check = subprocess.run(
                [*compose, "exec", "-T", "backend", "python", "manage.py", "check", "--deploy",
                 "--fail-level", "WARNING"], capture_output=True, text=True, env=env)
            check(deploy_check.returncode == 0, "backend: manage.py check --deploy")
            if deploy_check.returncode:
                print(deploy_check.stdout[-2000:], deploy_check.stderr[-2000:], file=sys.stderr)
            rounds = subprocess.run(
                [*compose, "exec", "-T", "backend", "python", "manage.py", "shell", "-c",
                 "from jungle.scheduler.models import JobRun; import json; "
                 "print(json.dumps(sorted({r.job for r in JobRun.objects.filter(ok=True)})))"],
                capture_output=True, text=True, env=env)
            done = json.loads(rounds.stdout.strip().splitlines()[-1]) if rounds.returncode == 0 else []
            check("send_notifications" in done, f"scheduler: a round done ({', '.join(done) or 'none'})")
            print("the backups", flush=True)
            for kind in ("full", "restore-test"):
                done = subprocess.run(
                    [str(ROOT / "deploy" / "scripts" / "backup"), kind],
                    capture_output=True, text=True,
                    env={**env, "JUNGLE_ENV_FILE": str(envf), "COMPOSE_PROJECT": PROJECT},
                )
                check(done.returncode == 0, f"backup {kind}")
                if done.returncode:
                    print(done.stdout[-3000:], done.stderr[-3000:], file=sys.stderr)
            reported = subprocess.run(
                [*compose, "exec", "-T", "backend", "python", "manage.py", "shell", "-c",
                 "from jungle.scheduler.models import JobRun; "
                 "print(sorted(r.job for r in JobRun.objects.filter(job__startswith='backup.', ok=True)))"],
                capture_output=True, text=True, env=env)
            check("['backup.full', 'backup.restore-test']" in reported.stdout,
                  "backups: both reported to the backend as done")
            load(compose, env, check)
            update_and_rollback(folder, envf, check)
            finished = True
        finally:
            if failures or not finished:
                logs = subprocess.run([*compose, "logs", "--tail", "40"], capture_output=True, text=True, env=env)
                print(logs.stdout[-6000:], file=sys.stderr)
            subprocess.run([*compose, "down", "-v", "--remove-orphans"], capture_output=True, env=env)
    print(f"smoke-stack: {'all checks passed' if not failures else f'{len(failures)} failed'}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
