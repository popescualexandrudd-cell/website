#!/usr/bin/env bash
# The club's database backups (ADR-0016, Stage 14B), on the server, from the repository folder:
#   deploy/scripts/backup full           # a complete backup (systemd: Sundays, 02:30)
#   deploy/scripts/backup diff           # what changed since the last full one (other days, 02:30)
#   deploy/scripts/backup restore-test   # the latest backup restored in a throw-away container
#                                        # and compared with the live database (monthly)
# Between backups the transaction log is archived continuously (archive_timeout = 5 minutes).
# Every run is reported to the backend (manage.py backup_report): a failure reaches the managers
# and admins at once, a success sends the monitoring's heartbeat.
# Settings: JUNGLE_ENV_FILE (default /etc/jungle/prod.env); COMPOSE_PROJECT (only for a test).
set -uo pipefail
kind="${1:-}"
case "$kind" in full|diff|restore-test) ;; *) echo "usage: $0 full|diff|restore-test" >&2; exit 2;; esac
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
compose=(docker compose -f "$ROOT/deploy/compose/prod/compose.yaml" --env-file "${JUNGLE_ENV_FILE:-/etc/jungle/prod.env}")
[ -n "${COMPOSE_PROJECT:-}" ] && compose+=(-p "$COMPOSE_PROJECT")
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
pgbackrest() { "${compose[@]}" exec -T -u postgres db pgbackrest --stanza=jungle "$@"; }

backup() {
  pgbackrest stanza-create && pgbackrest --type="$kind" backup && pgbackrest check && pgbackrest info
}

restore_test() {
  local live restored
  live="$("${compose[@]}" exec -T db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT count(*) FROM django_migrations"')" || return 1
  restored="$("${compose[@]}" run --rm --no-deps -T -u postgres db restore-check 1 | tail -n 1)" || return 1
  echo "live migrations: $live; restored: $restored"
  python3 -c 'import json,sys; r=json.loads(sys.argv[1]); sys.exit(0 if r["migrations"]==int(sys.argv[2]) and r["migrations"]>0 else 1)' \
    "$restored" "$live" || { echo "the restored database does not match the live one"; return 1; }
}

echo "backup $kind: started $(date -Is)" | tee -a "$log"
if [ "$kind" = restore-test ]; then restore_test >>"$log" 2>&1; else backup >>"$log" 2>&1; fi
status=$?
outcome=--ok; [ "$status" -eq 0 ] || outcome=--failed
echo "backup $kind: $([ "$status" -eq 0 ] && echo ok || echo FAILED) $(date -Is)" | tee -a "$log"
tail -c 4000 "$log" | "${compose[@]}" exec -T backend python manage.py backup_report --kind "$kind" "$outcome" \
  || echo "backup $kind: could not report to the backend" >&2
exit "$status"
