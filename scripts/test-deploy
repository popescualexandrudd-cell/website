#!/usr/bin/env bash
# The production setup (Stage 14, ADR-0015), checked before it reaches the server:
#   1. the production compose file is valid;
#   2. the proxy behaves as ADR-0012 asks, against a real Caddy (deploy/proxy/test-proxy);
#   3. the server scripts pass ShellCheck, and install-server works on a clean Ubuntu 24.04;
#   4. the whole stack starts from the compose file and answers through the proxy, takes a
#      backup, restores it, updates to a new version and goes back (deploy/scripts/smoke-stack:
#      builds the images, needs Docker, uv and the ports 80/443).
#   5. the busiest evening, with k6 (tests/load/club.js), inside step 4: LOAD_VISITORS (default 50)
#      visitors for LOAD_HOLD (default 30s); the report's run: LOAD_VISITORS=500 LOAD_HOLD=2m;
#   6. no known vulnerability in the production dependencies (pnpm audit, pip-audit);
#   7. the laptop demo (deploy/compose/dev, README): the site with the full site on, the panel.
# Run by CI on every push (job `deploy`); by hand: scripts/test-deploy
# Behind a filtering proxy, pass base images with its CA: SMOKE_BUILD_ARGS="--build-arg …".
set -euo pipefail
cd "$(dirname "$0")/.."
CADDY_VERSION=2.10.2
K6_VERSION=1.5.0

echo "==> The production compose file"
JUNGLE_VERSION=check POSTGRES_PASSWORD=check DOMAIN=example.test ACME_EMAIL=check@example.test \
  WEB_REVALIDATE_SECRET=check JUNGLE_ENV_FILE="$PWD/deploy/compose/prod/.env.example" \
  BACKUP_ENV_FILE="$PWD/deploy/backup/backup.env.example" \
  docker compose -f deploy/compose/prod/compose.yaml --profile monitoring config --format json |
  python3 -c '
import json, sys
services = json.load(sys.stdin)["services"]
bare = sorted(name for name, s in services.items() if "max-size" not in s.get("logging", {}).get("options", {}))
published = sorted(name for name, s in services.items() if s.get("ports") and name != "proxy")
assert not bare, f"services without log rotation: {bare}"
assert not published, f"only the proxy may be reachable from outside: {published}"
print(f"compose: {len(services)} services, logs rotated, only the proxy published")'

echo "==> The dependencies (no known vulnerability in what runs in production)"
pnpm audit --prod --audit-level low
uv export --frozen --no-dev --no-emit-workspace --no-hashes -o .cache/requirements-prod.txt -q
uvx --from pip-audit==2.9.0 pip-audit --strict --disable-pip --no-deps -r .cache/requirements-prod.txt

echo "==> The proxy (Caddy $CADDY_VERSION)"
if [ -z "${CADDY:-}" ]; then
  dir=".cache/caddy-$CADDY_VERSION"
  if [ ! -x "$dir/caddy" ]; then
    mkdir -p "$dir"
    curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v$CADDY_VERSION/caddy_${CADDY_VERSION}_linux_amd64.tar.gz" \
      | tar xz -C "$dir" caddy
  fi
  CADDY="$dir/caddy"
fi
CADDY="$CADDY" deploy/proxy/test-proxy

echo "==> The server scripts (ShellCheck)"
uvx --from shellcheck-py==0.11.0.1 shellcheck -S warning deploy/scripts/backup deploy/scripts/update \
  deploy/scripts/rollback deploy/scripts/install-server deploy/scripts/devices-ca deploy/scripts/manage \
  deploy/scripts/test-install deploy/scripts/configure deploy/scripts/reset-before-launch deploy/compose/dev/start-backend deploy/backup/postgres/restore-check \
  scripts/test-deploy

echo "==> The server's installation, on a clean Ubuntu 24.04 (a container)"
deploy/scripts/test-install

echo "==> The whole stack, the busiest evening, then an update, the way back and the reset"
if [ -z "${K6:-}" ]; then
  dir=".cache/k6-$K6_VERSION"
  if [ ! -x "$dir/k6" ]; then
    mkdir -p "$dir"
    curl -fsSL "https://github.com/grafana/k6/releases/download/v$K6_VERSION/k6-v${K6_VERSION}-linux-amd64.tar.gz" \
      | tar xz -C "$dir" --strip-components=1
  fi
  K6="$dir/k6"
fi
K6="$K6" deploy/scripts/smoke-stack

echo "==> The laptop demo (deploy/compose/dev, the README's quick start)"
dev=(docker compose -p jungle-dev-check -f deploy/compose/dev/compose.yaml)
# shellcheck disable=SC2329  # called by the trap
dev_down() { "${dev[@]}" down -v --remove-orphans >/dev/null 2>&1 || true; }
trap dev_down EXIT
"${dev[@]}" up -d --build
answer() { curl -s --noproxy '*' -o /dev/null -w '%{http_code}' --max-time 10 "$1" || true; }
for _ in $(seq 1 90); do [ "$(answer http://localhost:8000/api/v1/health)" = 200 ] && break; sleep 4; done
failed=0
for url in http://localhost:8000/api/v1/health http://localhost:3000/ro http://localhost:3000/ro/liga \
  http://localhost:5179/ http://localhost:5179/api/v1/auth/session; do
  code="$(answer "$url")"
  for _ in $(seq 1 15); do [ "$code" = 200 ] && break; sleep 2; code="$(answer "$url")"; done
  if [ "$code" = 200 ]; then echo "  ok   $url"; else echo "  FAIL $url ($code)"; failed=1; fi
done
if [ "$failed" = 1 ]; then "${dev[@]}" logs --tail 40; exit 1; fi
echo "laptop demo: all checks passed"
