#!/usr/bin/env bash
# Runs every check of the project with one command (§13.5, ADR-0021).
# Needs: uv, pnpm, Node.js >= 22 and a PostgreSQL reachable through DATABASE_URL
# (default postgres://jungle:jungle@localhost:5432/jungle; the test database is created automatically).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
step() { printf '\n==> %s\n' "$1"; }

step "Python dependencies"
uv sync --all-packages --frozen

step "Lint and formatting (ruff); the pre-push hook"
bash -n .githooks/pre-push
uv run ruff check .
uv run ruff format --check .

step "Types (mypy, strict)"
(cd apps/backend && uv run mypy jungle)
(cd packages/league-engine && uv run mypy src tools)
(cd services/hardware-bridge && uv run mypy src tests)

step "Database migrations are up to date"
(cd apps/backend && uv run python manage.py makemigrations --check --dry-run)

step "Backend tests (pytest, branch coverage)"
(cd apps/backend && uv run pytest --cov)

step "Money, league, screen, admin-panel and events-calendar modules: 100% branch coverage (ADR-0009, ADR-0008, R-012)"
(cd apps/backend && uv run coverage report --fail-under=100 --skip-covered \
  --include="jungle/ledger/*,jungle/subscriptions/*,jungle/rewards/*,jungle/cafe/*,jungle/league/*,jungle/checkout/*,jungle/screens/*,jungle/panel/*,jungle/events/*")

step "League engine tests (pytest + hypothesis, 100% branch coverage, openskill comparison)"
(cd packages/league-engine && uv run pytest --cov)

step "Hardware Bridge tests (simulators, signatures, cash journal, 100% branch coverage)"
(cd services/hardware-bridge && uv run pytest --cov)

step "Kiosk OS files (syntax, dry-run install, Chromium policy, service hardening)"
deploy/kiosk-os/check.sh

step "OpenAPI schema is up to date"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
uv run python apps/backend/manage.py export_openapi --output "$tmp_dir/openapi.json" >/dev/null
if ! diff -q packages/api-client/openapi.json "$tmp_dir/openapi.json" >/dev/null; then
  echo "OpenAPI schema changed. Run: scripts/generate-api-client" >&2
  exit 1
fi

step "JavaScript dependencies"
pnpm install --frozen-lockfile

step "Design tokens are up to date"
(cd packages/design-tokens && node build.mjs)
if ! git diff --quiet -- packages/design-tokens/dist; then
  echo "Design tokens changed: commit packages/design-tokens/dist (pnpm --filter @jungle/design-tokens build)" >&2
  exit 1
fi

step "Generated API client is up to date"
(cd packages/api-client && pnpm exec openapi-typescript openapi.json -o "$tmp_dir/schema.d.ts" >/dev/null)
if ! diff -q packages/api-client/src/schema.d.ts "$tmp_dir/schema.d.ts" >/dev/null; then
  echo "Generated client is stale. Run: scripts/generate-api-client" >&2
  exit 1
fi

step "TypeScript typecheck"
pnpm -r typecheck

step "Lint (ESLint, website)"
pnpm --filter @jungle/web lint

step "JavaScript tests (including RO/EN translation completeness and colour contrast)"
pnpm -r test

if [ "${SKIP_E2E:-0}" != "1" ]; then
  step "End-to-end tests (backend + website + Playwright, accessibility with axe)"
  scripts/test-e2e
fi

printf '\nAll checks passed.\n'
