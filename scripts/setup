#!/usr/bin/env bash
# Prepares a local development environment: dependencies, database, demo data.
# Needs a PostgreSQL (for example: docker compose -f deploy/compose/dev/compose.yaml up -d db redis).
set -euo pipefail
cd "$(cd "$(dirname "$0")/.." && pwd)"
# Every push runs scripts/test-all first (.githooks/pre-push): nothing red reaches GitHub.
git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks
uv sync --all-packages
pnpm install
(cd apps/backend && uv run python manage.py migrate && uv run python manage.py seed_initial --demo)
cat <<'MSG'

Setup done. Next steps:
  1. Create the first admin (the password is read from the environment, never typed on the command line):
       JUNGLE_ADMIN_PASSWORD='<a long password>' uv run python apps/backend/manage.py bootstrap_admin \
         --email you@example.com --first-name Nume --last-name Prenume
     Scan the printed otpauth:// link with an authenticator app; keep the recovery codes offline.
  2. Start the backend: scripts/dev
MSG
