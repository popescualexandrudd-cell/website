#!/usr/bin/env bash
# End-to-end tests across apps (§13.1): real backend + production build of the website + Playwright;
# then the League Kiosk: the real Hardware Bridge (simulators, signed scans) + its production build;
# then the Payments Kiosk and the café display, each with its own real Hardware Bridge (Stage 8);
# then the court and lobby screens, live through Redis as in production (Stage 9);
# then the admin panel with two-factor sign-in (Stage 10).
# Needs PostgreSQL (DATABASE_URL server, default localhost), Redis (E2E_REDIS_URL, or a local
# `redis-server` started here) and a Chromium for Playwright
# (PW_CHROMIUM_PATH, or `pnpm --filter @jungle/web exec playwright install chromium`).
# E2E_ONLY=web, kiosk, payments, screens or admin runs only that part (after the backend).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
BASE_DB_URL="${DATABASE_URL:-postgres://jungle:jungle@localhost:5432/jungle}"
E2E_DB_URL="${BASE_DB_URL%/*}/jungle_e2e"
WORK="$(mktemp -d)"
MAIL_DIR="$WORK/mail"
mkdir -p "$MAIL_DIR"
PIDS=()
cleanup() {
  for pid in "${PIDS[@]:-}"; do [ -n "$pid" ] && kill "$pid" 2>/dev/null || true; done
  # Wait until they are gone (at most 10 s each): the next run finds its ports free.
  for pid in "${PIDS[@]:-}"; do
    for _ in $(seq 1 50); do [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
  done
  rm -rf "$WORK"
}
trap cleanup EXIT

# A failed Playwright run: what the servers said (the traces are in apps/*/test-results).
failed() {
  for log in "$@"; do echo "==> $log"; cat "$log"; done
  # What each failed page showed at the end (Playwright's snapshot, without the test source).
  find apps/*/test-results -name error-context.md -newer "$WORK" 2>/dev/null | while read -r context; do
    echo "==> $context"
    sed '/^# Test source/,$d' "$context"
  done || true
  echo "==> backend.log (last 200 lines)"
  tail -n 200 "$WORK/backend.log"
  exit 1
}

# The preview servers run as vite itself (not through pnpm, which leaves its child running when
# stopped), so the cleanup stops them and the next run never tests a stale build.
# Whether a part runs: all of them, or only the one named in E2E_ONLY.
part() { [ -z "${E2E_ONLY:-}" ] || [ "$E2E_ONLY" = "$1" ]; }

if [ -z "${PW_CHROMIUM_PATH:-}" ] && [ -x /opt/pw-browsers/chromium-1194/chrome-linux/chrome ]; then
  export PW_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
fi

echo "==> Fresh e2e database; Redis (cache and live updates, as in production)"
if [ -n "${E2E_REDIS_URL:-}" ]; then
  REDIS_URL="$E2E_REDIS_URL"
else
  redis-server --port 6390 --bind 127.0.0.1 --save "" --appendonly no --dir "$WORK" >"$WORK/redis.log" 2>&1 &
  PIDS+=($!)
  for _ in $(seq 1 30); do redis-cli -p 6390 ping >/dev/null 2>&1 && break; sleep 0.2; done
  redis-cli -p 6390 ping >/dev/null 2>&1 || { echo "Redis did not start"; cat "$WORK/redis.log"; exit 1; }
  REDIS_URL=redis://127.0.0.1:6390/0
fi
psql "$BASE_DB_URL" -q -c "DROP DATABASE IF EXISTS jungle_e2e" -c "CREATE DATABASE jungle_e2e" >/dev/null

# The secret the backend and the website share for refreshing the pages after a flag changes (Q57).
REVALIDATE_SECRET="e2e-$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')"
export REVALIDATE_SECRET WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate WEB_REVALIDATE_SECRET="$REVALIDATE_SECRET"
export DATABASE_URL="$E2E_DB_URL" JUNGLE_ENV=dev DJANGO_SETTINGS_MODULE=jungle.settings DJANGO_DEBUG=false \
  EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend EMAIL_FILE_PATH="$MAIL_DIR" \
  WEB_BASE_URL=http://localhost:3000 KIOSK_ALLOW_LOOPBACK=true AI_FAKE=true REDIS_URL="$REDIS_URL" \
  CSRF_TRUSTED_ORIGINS=http://localhost:3000 CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
(cd apps/backend && uv run python manage.py migrate -v0 && uv run python manage.py seed_initial --demo >/dev/null)
(cd apps/backend && exec uv run python manage.py runserver 127.0.0.1:8000 --noreload >"$WORK/backend.log" 2>&1) &
PIDS+=($!)

if part web; then
echo "==> The hero video's test clip (ADR-0023): a few generated seconds, never committed"
HERO_E2E="apps/web/public/media/hero-e2e"
rm -rf "$HERO_E2E"
if command -v ffmpeg >/dev/null; then
  ffmpeg -y -v error -f lavfi -i "testsrc2=size=1280x720:rate=30" -t 4 -pix_fmt yuv420p "$WORK/hero-src.mp4"
  HERO_VIDEO_OUT="$PWD/$HERO_E2E" node apps/web/scripts/video-hero.mjs --input "$WORK/hero-src.mp4" --base /media/hero-e2e >/dev/null
  export HERO_VIDEO_MANIFEST="$PWD/$HERO_E2E/manifest.json" E2E_HERO_VIDEO=1
else
  echo "   ffmpeg is missing: the hero video test is skipped"
fi
echo "==> Production build of the website"
export NEXT_PUBLIC_API_URL=http://localhost:8000 NEXT_PUBLIC_SITE_URL=http://localhost:3000 NEXT_TELEMETRY_DISABLED=1
# A stand-in statistics script: the consent tests check that it is added only after "Accept".
export NEXT_PUBLIC_UMAMI_SRC=http://localhost:3000/e2e-statistics.js NEXT_PUBLIC_UMAMI_WEBSITE_ID=e2e
# The data cache of an earlier run (e.g. the full site turned on) must not leak into this build.
rm -rf apps/web/.next/cache/fetch-cache
pnpm --filter @jungle/web build >"$WORK/build.log" 2>&1 || { cat "$WORK/build.log"; exit 1; }
(cd apps/web && exec node_modules/.bin/next start --port 3000 >"$WORK/web.log" 2>&1) &
PIDS+=($!)

fi
for url in http://127.0.0.1:8000/api/v1/health $(part web && echo http://localhost:3000/ro); do
  for _ in $(seq 1 60); do curl -fs -o /dev/null "$url" && break; sleep 1; done
  curl -fs -o /dev/null "$url" || { echo "server not ready: $url"; cat "$WORK"/*.log; exit 1; }
done

if part web; then
  echo "==> Playwright (website: the pre-launch page)"
  E2E_MAIL_DIR="$MAIL_DIR" pnpm --filter @jungle/web exec playwright test || failed "$WORK/web.log"
  echo "==> The full site turned on from the server; the website refreshes at once (Q57)"
  (cd apps/backend && uv run python manage.py set_flag full_site on --reason "e2e: the full site")
  echo "==> Playwright (website: the full site, Stage 11)"
  E2E_SITE_MODE=full E2E_MAIL_DIR="$MAIL_DIR" E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" pnpm --filter @jungle/web exec playwright test ||
    failed "$WORK/web.log"
  echo "==> The site's effects turned on (ADR-0023): every test again, unchanged, plus the effects' own"
  (cd apps/backend && uv run python manage.py set_flag web_effects on --reason "e2e: the effects")
  (cd apps/backend && uv run python manage.py set_flag web_hero_video on --reason "e2e: the hero video")
  E2E_SITE_MODE=effects E2E_MAIL_DIR="$MAIL_DIR" pnpm --filter @jungle/web exec playwright test || failed "$WORK/web.log"
  (cd apps/backend && uv run python manage.py set_flag web_effects off --reason "e2e: the effects, done")
  (cd apps/backend && uv run python manage.py set_flag web_hero_video off --reason "e2e: the hero video, done")
  echo "==> The club's assistant (ADR-0019, 12D): the scripted provider (AI_FAKE, never an AI), a signed-in client"
  ASSISTANT_EMAIL="asistent-$(date +%s)@example.test"
  ASSISTANT_PASSWORD="e2e-$(python3 -c 'import secrets; print(secrets.token_urlsafe(12))')"
  (cd apps/backend && ASSISTANT_EMAIL="$ASSISTANT_EMAIL" ASSISTANT_PASSWORD="$ASSISTANT_PASSWORD" uv run python manage.py shell -c '
import os
from datetime import date
from jungle.accounts.models import User
from jungle.core import clock
User.objects.create_user(os.environ["ASSISTANT_EMAIL"], os.environ["ASSISTANT_PASSWORD"], first_name="Ana",
    last_name="Asistent", date_of_birth=date(1990, 1, 1), email_verified_at=clock.now())
')
  (cd apps/backend && uv run python manage.py set_flag ai on --reason "e2e: the assistant")
  E2E_SITE_MODE=assistant E2E_ASSISTANT_EMAIL="$ASSISTANT_EMAIL" E2E_ASSISTANT_PASSWORD="$ASSISTANT_PASSWORD" \
    pnpm --filter @jungle/web exec playwright test || failed "$WORK/web.log"
  (cd apps/backend && uv run python manage.py set_flag ai off --reason "e2e: the assistant, done")
fi

if part kiosk; then
echo "==> League Kiosk: demo data, Hardware Bridge (simulators), production build"
# The demo match ends on the last half hour and its score window lasts 30 minutes:
# never start in the last 3 minutes of a window.
while [ $(( $(date +%-M) % 30 )) -ge 27 ]; do sleep 10; done
BRIDGE_DIR="$WORK/bridge"
export BRIDGE_DATA_DIR="$BRIDGE_DIR" BRIDGE_ALLOWED_ORIGINS=http://localhost:5174 \
  BRIDGE_API_URL=http://localhost:8000/api/v1 BRIDGE_SIMULATOR_CONTROL=1
BRIDGE_KEY="$(BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000 uv run jungle-bridge public-key)"
(cd apps/backend && uv run python manage.py kiosk_demo --public-key "$BRIDGE_KEY" --output "$WORK/kiosk.json")
BRIDGE_DEVICE_ID="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["device_id"])' "$WORK/kiosk.json")"
BRIDGE_DEVICE_TOKEN="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["device_token"])' "$WORK/kiosk.json")"
(BRIDGE_DEVICE_ID="$BRIDGE_DEVICE_ID" BRIDGE_DEVICE_TOKEN="$BRIDGE_DEVICE_TOKEN" exec uv run jungle-bridge run >"$WORK/bridge.log" 2>&1) &
PIDS+=($!)
pnpm --filter @jungle/kiosk-league build >"$WORK/kiosk-build.log" 2>&1 || { cat "$WORK/kiosk-build.log"; exit 1; }
(cd apps/kiosk-league && exec node_modules/.bin/vite preview --port 5174 --strictPort >"$WORK/kiosk.log" 2>&1) &
PIDS+=($!)
for _ in $(seq 1 60); do curl -fs -o /dev/null http://localhost:5174/ && break; sleep 1; done
curl -fs -o /dev/null http://localhost:5174/ || { echo "kiosk not ready"; cat "$WORK"/kiosk*.log "$WORK/bridge.log"; exit 1; }

echo "==> Playwright (League Kiosk)"
E2E_KIOSK_DATA="$WORK/kiosk.json" E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" pnpm --filter @jungle/kiosk-league exec playwright test ||
  failed "$WORK/bridge.log"
fi

if part payments; then
echo "==> Payments Kiosk and café display: demo data, two Hardware Bridges (simulators), production builds"
SERVER_KEY="$(cd apps/backend && uv run python manage.py device_command_key)"
PAY_DIR="$WORK/bridge-payments"
DISPLAY_DIR="$WORK/bridge-display"
PAY_KEY="$(BRIDGE_DATA_DIR="$PAY_DIR" BRIDGE_ALLOWED_ORIGINS=http://localhost:5175 BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000 uv run jungle-bridge public-key)"
DISPLAY_KEY="$(BRIDGE_DATA_DIR="$DISPLAY_DIR" BRIDGE_ALLOWED_ORIGINS=http://localhost:5176 BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000 uv run jungle-bridge public-key)"
(cd apps/backend && uv run python manage.py payments_demo --public-key "$PAY_KEY" --display-key "$DISPLAY_KEY" --output "$WORK/payments.json")
field() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]][sys.argv[3]])' "$WORK/payments.json" "$1" "$2"; }
(BRIDGE_DATA_DIR="$PAY_DIR" BRIDGE_PORT=8766 BRIDGE_ALLOWED_ORIGINS=http://localhost:5175 \
  BRIDGE_API_URL=http://localhost:8000/api/v1 BRIDGE_SIMULATOR_CONTROL=1 BRIDGE_SERVER_PUBLIC_KEY="$SERVER_KEY" \
  BRIDGE_DEVICE_ID="$(field kiosk device_id)" BRIDGE_DEVICE_TOKEN="$(field kiosk device_token)" \
  exec uv run jungle-bridge run >"$WORK/bridge-payments.log" 2>&1) &
PIDS+=($!)
(BRIDGE_DATA_DIR="$DISPLAY_DIR" BRIDGE_PORT=8767 BRIDGE_ALLOWED_ORIGINS=http://localhost:5176 \
  BRIDGE_API_URL=http://localhost:8000/api/v1 BRIDGE_SIMULATOR_CONTROL=0 \
  BRIDGE_DEVICE_ID="$(field display device_id)" BRIDGE_DEVICE_TOKEN="$(field display device_token)" \
  exec uv run jungle-bridge run >"$WORK/bridge-display.log" 2>&1) &
PIDS+=($!)
VITE_BRIDGE_URL=ws://127.0.0.1:8766 pnpm --filter @jungle/kiosk-payments build >"$WORK/payments-build.log" 2>&1 || {
  cat "$WORK/payments-build.log"; exit 1; }
VITE_BRIDGE_URL=ws://127.0.0.1:8767 pnpm --filter @jungle/cafe-display build >"$WORK/display-build.log" 2>&1 || {
  cat "$WORK/display-build.log"; exit 1; }
(cd apps/kiosk-payments && exec node_modules/.bin/vite preview --port 5175 --strictPort >"$WORK/payments.log" 2>&1) &
PIDS+=($!)
(cd apps/cafe-display && exec node_modules/.bin/vite preview --port 5176 --strictPort >"$WORK/display.log" 2>&1) &
PIDS+=($!)
for url in http://localhost:5175/ http://localhost:5176/; do
  for _ in $(seq 1 60); do curl -fs -o /dev/null "$url" && break; sleep 1; done
  curl -fs -o /dev/null "$url" || { echo "not ready: $url"; cat "$WORK"/payments*.log "$WORK"/display*.log; exit 1; }
done

echo "==> Playwright (Payments Kiosk + café display)"
E2E_PAYMENTS_DATA="$WORK/payments.json" E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" \
  pnpm --filter @jungle/kiosk-payments exec playwright test ||
  failed "$WORK/bridge-payments.log" "$WORK/bridge-display.log"
fi

if part screens; then
echo "==> Court and lobby screens: demo data (§8.5), two Hardware Bridges, two production builds"
COURT_DIR="$WORK/bridge-court"
LOBBY_DIR="$WORK/bridge-lobby"
COURT_KEY="$(BRIDGE_DATA_DIR="$COURT_DIR" BRIDGE_ALLOWED_ORIGINS=http://localhost:5177 BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000 uv run jungle-bridge public-key)"
LOBBY_KEY="$(BRIDGE_DATA_DIR="$LOBBY_DIR" BRIDGE_ALLOWED_ORIGINS=http://localhost:5178 BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000 uv run jungle-bridge public-key)"
(cd apps/backend && uv run python manage.py screens_demo --court-key "$COURT_KEY" --lobby-key "$LOBBY_KEY" --output "$WORK/screens.json")
screen_field() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]][sys.argv[3]])' "$WORK/screens.json" "$1" "$2"; }
(BRIDGE_DATA_DIR="$COURT_DIR" BRIDGE_PORT=8768 BRIDGE_ALLOWED_ORIGINS=http://localhost:5177 \
  BRIDGE_API_URL=http://localhost:8000/api/v1 BRIDGE_SIMULATOR_CONTROL=0 \
  BRIDGE_DEVICE_ID="$(screen_field court device_id)" BRIDGE_DEVICE_TOKEN="$(screen_field court device_token)" \
  exec uv run jungle-bridge run >"$WORK/bridge-court.log" 2>&1) &
PIDS+=($!)
(BRIDGE_DATA_DIR="$LOBBY_DIR" BRIDGE_PORT=8769 BRIDGE_ALLOWED_ORIGINS=http://localhost:5178 \
  BRIDGE_API_URL=http://localhost:8000/api/v1 BRIDGE_SIMULATOR_CONTROL=0 \
  BRIDGE_DEVICE_ID="$(screen_field lobby device_id)" BRIDGE_DEVICE_TOKEN="$(screen_field lobby device_token)" \
  exec uv run jungle-bridge run >"$WORK/bridge-lobby.log" 2>&1) &
PIDS+=($!)
# One build per screen machine (each knows its own bridge's port), the same code.
VITE_BRIDGE_URL=ws://127.0.0.1:8768 pnpm --filter @jungle/court-screens build >"$WORK/screens-build.log" 2>&1 || {
  cat "$WORK/screens-build.log"; exit 1; }
(cd apps/court-screens && VITE_BRIDGE_URL=ws://127.0.0.1:8769 pnpm exec vite build --outDir "$WORK/lobby-dist" --emptyOutDir \
  >"$WORK/lobby-build.log" 2>&1) || { cat "$WORK/lobby-build.log"; exit 1; }
(cd apps/court-screens && exec node_modules/.bin/vite preview --port 5177 --strictPort >"$WORK/screens.log" 2>&1) &
PIDS+=($!)
(cd apps/court-screens && exec node_modules/.bin/vite preview --port 5178 --strictPort --outDir "$WORK/lobby-dist" \
  >"$WORK/lobby.log" 2>&1) &
PIDS+=($!)
for url in http://localhost:5177/ http://localhost:5178/; do
  for _ in $(seq 1 60); do curl -fs -o /dev/null "$url" && break; sleep 1; done
  curl -fs -o /dev/null "$url" || { echo "not ready: $url"; cat "$WORK"/screens*.log "$WORK"/lobby*.log; exit 1; }
done

echo "==> Playwright (court and lobby screens)"
E2E_SCREENS_DATA="$WORK/screens.json" E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" \
  pnpm --filter @jungle/court-screens exec playwright test ||
  failed "$WORK/bridge-court.log" "$WORK/bridge-lobby.log"
fi

if part web && part kiosk && part screens; then
  echo "==> The league page with real league data (the kiosk's confirmed matches, the screens' ranked players)"
  E2E_SITE_MODE=league-data E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" pnpm --filter @jungle/web exec playwright test ||
    failed "$WORK/web.log"
fi

if part admin; then
echo "==> Admin panel: an administrator with 2FA, demo staff and bookings, the production build"
ADMIN_PASSWORD="e2e-$(python3 -c 'import secrets; print(secrets.token_urlsafe(18))')"
(cd apps/backend && JUNGLE_ADMIN_PASSWORD="$ADMIN_PASSWORD" uv run python manage.py bootstrap_admin \
  --email admin-e2e@demo.invalid --first-name Admin --last-name E2E >"$WORK/admin.txt")
ADMIN_SECRET="$(python3 -c 'import re,sys; print(re.search(r"secret=([A-Z2-7]+)", open(sys.argv[1]).read()).group(1))' "$WORK/admin.txt")"
(cd apps/backend && JUNGLE_DEMO_PASSWORD="$ADMIN_PASSWORD" uv run python manage.py panel_demo --output "$WORK/panel.json")
python3 - "$WORK/panel.json" "$WORK/admin.json" "$ADMIN_PASSWORD" "$ADMIN_SECRET" <<'PY'
import json, sys
demo = json.load(open(sys.argv[1]))
admin = {"email": "admin-e2e@demo.invalid", "password": sys.argv[3], "secret": sys.argv[4]}
json.dump({"admin": admin, "password": sys.argv[3], "demo": demo}, open(sys.argv[2], "w"))
PY
pnpm --filter @jungle/admin build >"$WORK/admin-build.log" 2>&1 || { cat "$WORK/admin-build.log"; exit 1; }
if curl -fs -o /dev/null http://localhost:5179/; then
  echo "port 5179 is already taken (a panel server left from an earlier run?)"; exit 1
fi
# vite itself, not through pnpm: stopping it at the end then stops the server too.
(cd apps/admin && VITE_API_ORIGIN=http://127.0.0.1:8000 exec node_modules/.bin/vite preview --port 5179 --strictPort \
  >"$WORK/admin.log" 2>&1) &
PIDS+=($!)
for _ in $(seq 1 60); do curl -fs -o /dev/null http://localhost:5179/ && break; sleep 1; done
curl -fs -o /dev/null http://localhost:5179/ || { echo "not ready: admin"; cat "$WORK/admin.log"; exit 1; }

echo "==> Playwright (admin panel)"
E2E_ADMIN_DATA="$WORK/admin.json" E2E_SCREENSHOTS="${E2E_SCREENSHOTS:-}" \
  pnpm --filter @jungle/admin exec playwright test || failed "$WORK/admin.log"
fi
