{
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter Variable", "Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "gutter": { "$type": "dimension", "$value": "clamp(20px, 5vw, 64px)" },
    "section": { "$type": "dimension", "$value": "clamp(88px, 13vw, 176px)" }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": "0 1px 2px rgba(11, 18, 32, 0.04), 0 8px 24px rgba(11, 18, 32, 0.06)" },
    "lift": { "$type": "shadow", "$value": "0 2px 4px rgba(11, 18, 32, 0.05), 0 24px 48px -12px rgba(11, 18, 32, 0.18)" }
  },
  "motion": {
    "ease-out": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "duration-fast": { "$type": "duration", "$value": "180ms" },
    "duration-slow": { "$type": "duration", "$value": "800ms" }
  }
}
