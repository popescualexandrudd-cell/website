{
  "name": "antrenor-tenis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "tsx scripts/images.ts --if-missing",
    "dev": "next dev",
    "prebuild": "tsx scripts/images.ts --if-missing",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "images": "tsx scripts/images.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "worker": "tsx worker/index.ts",
    "build:tools": "node scripts/build-tools.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/barlow-condensed": "5.3.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.3",
    "markdown-it": "15.0.2",
    "next": "16.3.6",
    "next-intl": "4.14.6",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
