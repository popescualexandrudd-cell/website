// Schema bazei de date. Câmpurile traductibile sunt `Json` de forma { "ro": "...", "en": "..." };
// helperul `t(field, locale)` din lib/i18n-content.ts revine la "ro" când lipsește traducerea.

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AdminRole {
  PROPRIETAR
  EDITOR
}

enum BookingMode {
  CERERE
  INSTANT
}

enum Audience {
  COPII
  JUNIORI
  ADULTI
  TOATE
}

enum Level {
  INCEPATOR
  INTERMEDIAR
  AVANSAT
  COMPETITIE
  TOATE
}

enum PriceUnit {
  LECTIE
  PERSOANA
  LUNA
  PACHET
  EVENIMENT
}

enum Surface {
  ZGURA
  HARD
  IARBA
  SINTETIC
  COVOR
}

enum FacilityType {
  DOTARE_BAZA
  SERVICIU_ANTRENOR
  ECHIPAMENT
}

enum PostStatus {
  CIORNA
  PUBLICAT
}

enum FaqCategory {
  INCEPUT
  ECHIPAMENT
  COPII
  PROGRAM_PLATA
  TEREN_VREME
  COMPETITIE
}

enum GalleryCategory {
  LECTII
  GRUPE
  TURNEE
  TERENURI
  EVENIMENTE
}

enum ExceptionType {
  BLOCAT
  DISPONIBIL_EXTRA
}

enum BookingStatus {
  IN_ASTEPTARE
  CONFIRMATA
  ANULATA_CLIENT
  ANULATA_ANTRENOR
  EFECTUATA
  NEPREZENTARE
}

enum BookingSource {
  SITE
  ADMIN
  TELEFON
  WHATSAPP
}

enum WaitlistStatus {
  NOU
  CONTACTAT
  INSCRIS
  ARHIVAT
}

enum MessageStatus {
  NOU
  CITIT
  ARHIVAT
}

enum EmailStatus {
  IN_ASTEPTARE
  TRIMIS
  ESUAT
}

enum MediaKind {
  IMAGINE
  VIDEO
}

/// Videos are converted in the background after upload; images are ready at once.
enum MediaStatus {
  GATA
  IN_PROCESARE
  EROARE
}

/// The ITF Play and Stay stages of junior tennis: ball, court and racquet grow with the child.
enum BallStage {
  ROSU
  PORTOCALIU
  VERDE
  GALBEN
}

enum ResultLevel {
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

/// A waiting-list entry, or a request for a junior's assessment before joining a group.
enum WaitlistKind {
  LISTA
  EVALUARE
}

/// Who runs a tournament held at the club.
enum TournamentOrganizer {
  FRT
  TENIS10
  SPORTYA
  CLUB
  ALTUL
}

enum LegalKind {
  CONFIDENTIALITATE
  TERMENI
  COOKIES
}

// ─── Content ─────────────────────────────────────────────────────────────────

model SiteSettings {
  id                   Int         @id @default(1)
  brandName            String
  monogram             String
  tagline              Json
  /// The club's logo (a raster image with transparency); without one, the monogram is shown.
  logoId               String?
  logo                 Media?      @relation("SiteLogo", fields: [logoId], references: [id], onDelete: SetNull)
  /// Opening of the home page: a real video of the club (muted, looped), or a photograph.
  heroVideoId          String?
  heroVideo            Media?      @relation("HeroVideo", fields: [heroVideoId], references: [id], onDelete: SetNull)
  heroImageId          String?
  heroImage            Media?      @relation("HeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  /// Brand colours (#rrggbb): the dark base of the design and the accent of buttons and links.
  colorBrand           String      @default("#0f3b2f")
  colorAccent          String      @default("#c24f1d")
  phone                String
  whatsapp             String
  email                String
  instagramUrl         String?
  facebookUrl          String?
  tiktokUrl            String?
  seoTitle             Json
  seoDescription       Json
  bookingMode          BookingMode @default(CERERE)
  freeCancelHours      Int         @default(24)
  minNoticeHours       Int         @default(12)
  horizonDays          Int         @default(60)
  bufferMinutes        Int         @default(10)
  slotStepMinutes      Int         @default(30)
  firstLessonText      Json
  paymentMethods       Json
  workingHours         Json
  legalForm            String
  legalName            String
  legalCui             String
  legalRegNo           String?
  legalAddress         String
  enEnabled            Boolean     @default(true)
  umamiEnabled         Boolean     @default(false)
  reviewInvitesEnabled Boolean     @default(true)
  newsletterEnabled    Boolean     @default(true)
  /// The AI assistant on the site (it also needs ANTHROPIC_API_KEY on the server).
  assistantEnabled     Boolean     @default(true)
  /// The year the club opened; shown in its story and figures.
  foundedYear          Int?
  /// Court hire rates, as Markdown ({ ro, en }); empty = "ask on the phone".
  rentalRates          Json?
  retentionMonths      Int         @default(24)
  timezone             String      @default("Europe/Bucharest")
  currency             String      @default("RON")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

/// A member of the coaching team. The head coach comes first and speaks for the academy.
model Coach {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  /// Role in the team: head coach, junior academy coach, fitness coach…
  role            Json
  /// Title as on the diploma.
  title           Json
  /// One or two sentences for the team cards.
  summary         Json
  story           Json
  philosophy      Json?
  results         Json?
  specialties     Json
  yearsExperience Int?
  languages       Json
  photoId         String?
  photo           Media?          @relation("CoachPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  videoId         String?
  video           Media?          @relation("CoachVideo", fields: [videoId], references: [id], onDelete: SetNull)
  isHead          Boolean         @default(false)
  order           Int             @default(0)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  certifications  Certification[]

  @@index([order])
}

model Certification {
  id        String   @id @default(cuid())
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  title     Json
  issuer    String
  year      Int?
  imageId   String?
  image     Media?   @relation("CertificationImage", fields: [imageId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, order])
}

model Scene {
  id        String   @id @default(cuid())
  key       String   @unique
  order     Int      @default(0)
  indexName Json
  title     Json
  body      Json
  ctaLabel  Json?
  ctaHref   String?
  extra     Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// A training programme (Inițiere, Competiție, Amatori): who it is for and what it works on.
/// It is chosen first when booking; the lesson itself is a LessonType.
model Program {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           Json
  summary        Json
  description    Json
  focusPoints    Json
  audience       Audience        @default(TOATE)
  level          Level           @default(TOATE)
  ageMin         Int?
  ageMax         Int?
  imageId        String?
  image          Media?          @relation("ProgramImage", fields: [imageId], references: [id], onDelete: SetNull)
  order          Int             @default(0)
  bookableOnline Boolean         @default(true)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  faqs           Faq[]
  waitlist       WaitlistEntry[]
  academyGroups  AcademyGroup[]

  @@index([order])
  @@index([active])
}

/// What is booked: individual, for two, for three, group, biomechanical analysis. Every lesson
/// takes the coach's time exclusively, for the duration the client picks.
model LessonType {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            Json
  summary         Json
  minParticipants Int           @default(1)
  maxParticipants Int           @default(1)
  /// Durations offered in the booking form, in minutes.
  durations       Int[]         @default([60, 90, 120])
  /// Price for one hour; the price of a lesson is proportional to its duration.
  hourlyRate      Decimal?      @db.Decimal(10, 2)
  priceUnit       PriceUnit     @default(LECTIE)
  order           Int           @default(0)
  bookableOnline  Boolean       @default(true)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookings        Booking[]
  pricingPlans    PricingPlan[]

  @@index([order])
}

/// A group of the junior academy, by age and stage: who it is for, what it works on, when it
/// trains. Parents ask for an assessment before a child joins (WaitlistEntry, kind EVALUARE).
model AcademyGroup {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               Json
  stage              BallStage?
  ageMin             Int?
  ageMax             Int?
  level              Level           @default(TOATE)
  summary            Json
  focusPoints        Json
  sessionsPerWeek    Int?
  sessionMinutes     Int?
  /// Days and hours, as parents read them: "Monday and Wednesday, 17:00–18:30".
  schedule           Json?
  monthlyFee         Decimal?        @db.Decimal(10, 2)
  maxPlayers         Int?
  imageId            String?
  image              Media?          @relation("AcademyGroupImage", fields: [imageId], references: [id], onDelete: SetNull)
  programId          String?
  program            Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  order              Int             @default(0)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  evaluationRequests WaitlistEntry[]

  @@index([order])
}

/// A tournament result of an academy player, entered by the admin. Results of minors are
/// published only with the parents' written consent.
model Result {
  id              String      @id @default(cuid())
  athlete         String
  event           String
  category        String
  placement       Json
  date            DateTime    @db.Date
  level           ResultLevel @default(NATIONAL)
  isMinor         Boolean     @default(true)
  parentalConsent Boolean     @default(false)
  consentAt       DateTime?
  published       Boolean     @default(false)
  order           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([published, date])
}

model PricingPlan {
  id           String      @id @default(cuid())
  lessonTypeId String?
  lessonType   LessonType? @relation(fields: [lessonTypeId], references: [id], onDelete: SetNull)
  name         Json
  price        Decimal?    @db.Decimal(10, 2)
  currency     String      @default("RON")
  unit         PriceUnit   @default(LECTIE)
  sessions     Int?
  validityDays Int?
  includes     Json?
  highlighted  Boolean     @default(false)
  isPackage    Boolean     @default(false)
  order        Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  clients      Client[]

  @@index([lessonTypeId])
  @@index([order])
}

model Location {
  id                String             @id @default(cuid())
  name              String
  address           String
  city              String
  /**
   * County and postal code, for the address search engines read (schema.org PostalAddress).
   */
  region            String?
  postalCode        String?
  lat               Float?
  lng               Float?
  mapUrl            String?
  directions        Json?
  order             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courts            Court[]
  facilities        Facility[]
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
}

model Court {
  id              String    @id @default(cuid())
  locationId      String
  location        Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name            Json
  surface         Surface
  count           Int?
  coveredInWinter Boolean?
  floodlights     Boolean?
  active          Boolean   @default(true)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]

  @@index([locationId])
}

model Facility {
  id           String       @id @default(cuid())
  locationId   String?
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type         FacilityType
  name         Json
  description  Json?
  illustration String?
  imageId      String?
  image        Media?       @relation("FacilityImage", fields: [imageId], references: [id], onDelete: SetNull)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([type, order])
}

model Testimonial {
  id        String    @id @default(cuid())
  author    String
  role      Json
  text      Json
  photoId   String?
  photo     Media?    @relation("TestimonialPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  consent   Boolean   @default(false)
  consentAt DateTime?
  published Boolean   @default(false)
  isExample Boolean   @default(false)
  bookingId String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, order])
}

model GalleryItem {
  id              String          @id @default(cuid())
  mediaId         String
  media           Media           @relation("GalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  alt             Json
  caption         Json?
  category        GalleryCategory @default(LECTII)
  hasMinors       Boolean         @default(false)
  parentalConsent Boolean         @default(false)
  consentAt       DateTime?
  published       Boolean         @default(false)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([published, order])
}

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          Json
  excerpt        Json
  body           Json
  coverId        String?
  cover          Media?     @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  status         PostStatus @default(CIORNA)
  publishedAt    DateTime?
  seoTitle       Json?
  seoDescription Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Faq {
  id         String      @id @default(cuid())
  question   Json
  answer     Json
  category   FaqCategory @default(INCEPUT)
  showOnHome Boolean     @default(false)
  programId  String?
  program    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([category, order])
  @@index([showOnHome])
}

model LegalPage {
  id               String    @id @default(cuid())
  kind             LegalKind @unique
  title            Json
  body             Json
  version          String
  reviewedByLawyer Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PageHeader {
  id             String   @id @default(cuid())
  key            String   @unique
  title          Json
  intro          Json
  imageId        String?
  image          Media?   @relation("PageHeaderImage", fields: [imageId], references: [id], onDelete: SetNull)
  imageAlt       Json?
  seoTitle       Json?
  seoDescription Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id             String          @id @default(cuid())
  path           String          @unique
  kind           MediaKind       @default(IMAGINE)
  status         MediaStatus     @default(GATA)
  mimeType       String
  width          Int
  height         Int
  blurDataURL    String
  alt            Json
  size           Int
  /// Images: [{ w, avif, webp }]. Videos: [{ w, h, mp4 }].
  variants       Json
  /// Videos: a frame of the video as image variants [{ w, avif, webp }], shown before it plays.
  poster         Json?
  durationSec    Float?
  /// Why a video could not be converted, for the admin.
  error          String?
  /// When a process took the video for conversion (a stale claim is taken over).
  processingAt   DateTime?
  originalName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  coachPhotos    Coach[]         @relation("CoachPhoto")
  coachVideos    Coach[]         @relation("CoachVideo")
  siteLogos      SiteSettings[]  @relation("SiteLogo")
  heroVideos     SiteSettings[]  @relation("HeroVideo")
  heroImages     SiteSettings[]  @relation("HeroImage")
  academyGroups  AcademyGroup[]  @relation("AcademyGroupImage")
  certifications Certification[] @relation("CertificationImage")
  programs       Program[]       @relation("ProgramImage")
  facilities     Facility[]      @relation("FacilityImage")
  testimonials   Testimonial[]   @relation("TestimonialPhoto")
  galleryItems   GalleryItem[]   @relation("GalleryMedia")
  posts          Post[]          @relation("PostCover")
  pageHeaders    PageHeader[]    @relation("PageHeaderImage")

  @@index([createdAt])
  @@index([kind, status])
}

// ─── Schedule & bookings ─────────────────────────────────────────────────────

model AvailabilityRule {
  id         String    @id @default(cuid())
  weekday    Int
  startTime  String
  endTime    String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  validFrom  DateTime? @db.Date
  validTo    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([weekday])
}

model AvailabilityException {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  startTime String?
  endTime   String?
  type      ExceptionType
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
}

model Booking {
  id              String        @id @default(cuid())
  code            String        @unique
  programId       String
  program         Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  lessonTypeId    String?
  lessonType      LessonType?   @relation(fields: [lessonTypeId], references: [id], onDelete: Restrict)
  durationMin     Int           @default(60)
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  courtId         String?
  court           Court?        @relation(fields: [courtId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  blockedUntil    DateTime      @db.Timestamptz(3)
  status          BookingStatus @default(IN_ASTEPTARE)
  name            String
  email           String
  phone           String
  participants    Int           @default(1)
  declaredLevel   Level?
  message         String?
  forMinor        Boolean       @default(false)
  parentName      String?
  childFirstName  String?
  childAge        Int?
  gdprConsent     Boolean
  gdprConsentAt   DateTime
  policyVersion   String
  cancelTokenHash String        @unique
  reviewTokenHash String?       @unique
  source          BookingSource @default(SITE)
  /// Where the visitor came from (campaign, search, social); see lib/attribution.ts.
  attribution     Json?
  internalNotes   String?
  locale          String        @default("ro")
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  completedAt     DateTime?
  reminderSentAt  DateTime?
  reviewInviteAt  DateTime?
  anonymizedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  emailLogs       EmailLog[]

  @@index([startsAt])
  @@index([status])
  @@index([email])
  @@index([clientId])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  kind           WaitlistKind   @default(LISTA)
  programId      String?
  program        Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  groupId        String?
  group          AcademyGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  childFirstName String?
  /// How much the child has played so far, in the parent's words.
  experience     String?
  preferences    String
  name           String
  email          String
  phone          String
  message        String?
  forMinor       Boolean        @default(false)
  childAge       Int?
  consent        Boolean
  consentAt      DateTime
  policyVersion  String
  status         WaitlistStatus @default(NOU)
  /// Where the visitor came from (campaign, search, social); see lib/attribution.ts.
  attribution    Json?
  locale         String         @default("ro")
  anonymizedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([email])
}

model Client {
  id                String       @id @default(cuid())
  name              String
  email             String?      @unique
  phone             String?
  notes             String?
  activePlanId      String?
  activePlan        PricingPlan? @relation(fields: [activePlanId], references: [id], onDelete: SetNull)
  sessionsRemaining Int?
  packageValidUntil DateTime?    @db.Date
  anonymizedAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]

  @@index([phone])
  @@index([name])
}

// ─── System ──────────────────────────────────────────────────────────────────

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(EDITOR)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String    @id
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ContactMessage {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  status        MessageStatus @default(NOU)
  /// Where the visitor came from (campaign, search, social); see lib/attribution.ts.
  attribution   Json?
  consent       Boolean
  consentAt     DateTime
  policyVersion String
  locale        String        @default("ro")
  anonymizedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id                   String    @id @default(cuid())
  email                String    @unique
  confirmTokenHash     String?   @unique
  confirmedAt          DateTime?
  unsubscribeTokenHash String    @unique
  locale               String    @default("ro")
  consentAt            DateTime
  policyVersion        String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdAt])
  @@index([entity, entityId])
}

model EmailLog {
  id            String      @id @default(cuid())
  to            String
  template      String
  subject       String
  status        EmailStatus @default(IN_ASTEPTARE)
  error         String?
  attempts      Int         @default(0)
  nextAttemptAt DateTime?
  payload       Json
  bookingId     String?
  booking       Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

/// A tournament held at the club: upcoming ones with dates and registration, and the recurring
/// ones the club hosts (no dates needed).
model Tournament {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            Json
  organizer       TournamentOrganizer
  /// Age group or level, e.g. "Tenis10, până la 10 ani".
  category        Json?
  summary         Json?
  startsOn        DateTime?           @db.Date
  endsOn          DateTime?           @db.Date
  registrationUrl String?
  resultsUrl      String?
  published       Boolean             @default(true)
  order           Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([startsOn])
}
