# Copy to .env on the server and fill in. Never commit the real .env (secrets!).
# JUNGLE_ENV: dev | test | staging | prod  (staging/prod refuse to start without real secrets)
JUNGLE_ENV=dev
DJANGO_DEBUG=false
# Long random strings, different for every environment:
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=api.example.invalid
DATABASE_URL=postgres://jungle:CHANGE_ME@db:5432/jungle
REDIS_URL=redis://redis:6379/0

# Cookies shared between www.<domain> and api.<domain> (domain: DE_CONFIRMAT, Q39)
SESSION_COOKIE_DOMAIN=.example.invalid
CSRF_COOKIE_DOMAIN=.example.invalid
CSRF_TRUSTED_ORIGINS=https://www.example.invalid,https://admin.example.invalid
CORS_ALLOWED_ORIGINS=https://www.example.invalid,https://admin.example.invalid,https://kiosk-liga.example.invalid
WEB_BASE_URL=https://www.example.invalid
TRUSTED_PROXY_COUNT=1

# Email provider (Q24: still to be chosen). SMTP settings of the chosen provider:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Jungle Padel <no-reply@example.invalid>

# Emergency Django admin (§8.6) and public API docs
EMERGENCY_ADMIN_ENABLED=true
API_DOCS_ENABLED=false
LOG_LEVEL=INFO

# Fiscal cash register (R-066): simulator until the model is chosen (Q23).
FISCAL_PRINTER=simulator

# Apple Wallet (Q24): the club's Apple Developer account, a "Pass Type ID" certificate and
# Apple's WWDR intermediate certificate, as files on the server (steps: the Stage 5 report).
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=pass.ro.junglepadel.member
APPLE_TEAM_ID=
APPLE_PASS_CERT_FILE=/run/secrets/apple-pass-cert.pem
APPLE_PASS_KEY_FILE=/run/secrets/apple-pass-key.pem
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERT_FILE=/run/secrets/apple-wwdr-g4.pem
APPLE_WALLET_WEB_SERVICE_URL=https://api.example.invalid/api/v1/wallet/apple
APPLE_APNS_HOST=https://api.push.apple.com

# Google Wallet (Q24): the issuer id and a service account key (JSON file on the server).
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=/run/secrets/google-wallet-service-account.json
