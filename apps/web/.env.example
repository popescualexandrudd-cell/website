# Public website (apps/web). Copy to .env.local for development; on the server set real values.
# Base URL of the API (api.<domain>, DE_CONFIRMAT Q39)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the site's server reads the API, when it differs from the public address (production:
# http://proxy:8080, the proxy's internal listener, set by deploy/compose/prod). Empty: NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Public URL of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Allow search engines to index the site: only "true" in production
SITE_INDEXABLE=false
# Optional self-hosted, cookie-free analytics (Umami, ADR-0017); loaded only after the visitor accepts statistics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Secret shared with the backend (its WEB_REVALIDATE_SECRET): lets it refresh the pages right after a
# flag or a setting changes (POST /api/revalidate). Empty: the route does not exist; pages refresh within 5 min.
REVALIDATE_SECRET=
