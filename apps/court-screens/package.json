{
  "name": "@jungle/court-screens",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Padel court and lobby screens (§8.5): the session on court with the public league fields, standings, events, café orders ready; live.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5177 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@jungle/api-client": "workspace:*",
    "@jungle/design-tokens": "workspace:*",
    "@jungle/i18n": "workspace:*",
    "@jungle/kiosk-kit": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
