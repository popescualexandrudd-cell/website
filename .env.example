# ─────────────────────────────────────────────────────────────────────────────
#  Configurația aplicației. Copiază fișierul în `.env` și completează valorile.
#  Liniile care încep cu # sunt explicații și nu sunt citite.
#  Aplicația verifică fișierul la pornire și spune clar ce lipsește.
# ─────────────────────────────────────────────────────────────────────────────

# Adresa publică a site-ului, cu https:// și fără / la final.
# În dezvoltare: http://localhost:3000
APP_URL=http://localhost:3000

# Domeniul pentru care Caddy cere certificatul HTTPS (doar în producție),
# fără https:// și fără www. Exemplu: numele-tau-tenis.ro
DOMAIN=localhost

# Adresa de email la care Let's Encrypt trimite avertizări despre certificat (producție).
ACME_EMAIL=adresa@domeniu.ro

# Cheie secretă pentru semnarea linkurilor din emailuri și a sesiunilor.
# Generează una cu:  openssl rand -base64 48
# Nu o publica nicăieri și nu o schimba după lansare (linkurile vechi ar înceta să meargă).
AUTH_SECRET=schimba-ma-cu-o-cheie-lunga-generata-cu-openssl-rand-base64-48

# ── Baza de date ─────────────────────────────────────────────────────────────
# Utilizatorul, parola și numele bazei. În producție, pune o parolă lungă.
POSTGRES_USER=tenis
POSTGRES_PASSWORD=tenis
POSTGRES_DB=tenis

# Adresa completă a bazei de date, pentru dezvoltare (docker-compose.dev.yml, host = localhost).
# În producție nu contează: docker-compose.yml o construiește singur din valorile de mai sus.
DATABASE_URL=postgresql://tenis:tenis@localhost:5432/tenis

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# În dezvoltare, Mailpit prinde toate emailurile: http://localhost:8025
# În producție, folosește datele de la furnizorul tău de email (ex. Brevo, Mailgun,
# Amazon SES sau contul de email al domeniului).
SMTP_HOST=localhost
SMTP_PORT=1025
# true doar pentru portul 465 (SSL direct); pentru 587 lasă false (STARTTLS automat)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Expeditorul emailurilor către clienți. Adresa trebuie să fie pe domeniul tău.
EMAIL_FROM="Clubul Tenis Elite <rezervari@localhost>"

# Unde primești tu notificările despre rezervări noi și mesaje.
# Dacă lipsește, se folosește emailul din Setări (admin).
COACH_NOTIFY_EMAIL=

# ── Fișiere încărcate ────────────────────────────────────────────────────────
# Directorul în care se salvează fotografiile și video-urile încărcate din admin.
# În Docker este volumul `media`; nu schimba în producție.
MEDIA_DIR=./storage/media

# Programul ffmpeg, care convertește video-urile încărcate în MP4 pentru web.
# Gol = `ffmpeg` din PATH (imaginea Docker îl are deja). Local: instalează ffmpeg
# (Windows: `winget install ffmpeg`, macOS: `brew install ffmpeg`, Linux: `apt install ffmpeg`).
FFMPEG_PATH=

# true dacă aplicația stă în spatele unui proxy (Caddy) care trimite IP-ul real.
TRUST_PROXY=true

# ── Opțional: Cloudflare Turnstile (anti-spam pe formulare) ─────────────────
# Lasă gol pentru a-l dezactiva. Cheile se obțin gratuit din contul Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Opțional: Umami (statistici fără cookie-uri) ────────────────────────────
# Pornește cu:  docker compose --profile analytics up -d
# Apoi creează site-ul în Umami și copiază aici ID-ul și adresa scriptului.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Parolă pentru baza de date Umami și cheia internă (doar dacă folosești Umami).
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Subdomeniul pe care deschizi Umami, de exemplu statistici.numele-tau-tenis.ro
UMAMI_DOMAIN=

# ── Opțional: asistentul AI de pe site ──────────────────────────────────────
# Răspunde vizitatorilor (vârste, grupe, prețuri, program) doar din conținutul publicat în admin
# și îi trimite spre evaluare sau rezervare. Cheia se creează în contul Anthropic
# (https://console.anthropic.com → API Keys). Fără cheie, asistentul nu apare pe site.
# Se poate opri oricând și din admin: Setări → Funcții.
ANTHROPIC_API_KEY=
# Modelul folosit (implicit claude-opus-5). Pentru costuri mai mici: claude-sonnet-5.
ASSISTANT_MODEL=
# Câte întrebări primește asistentul pe zi, pe tot site-ul (implicit 400), ca să nu crească
# factura dacă cineva abuzează. Fiecare vizitator are și limita lui: 12 în 10 minute.
ASSISTANT_DAILY_LIMIT=

# ── Opțional: măsurarea campaniilor (Google Analytics, Google Ads, Meta) ────
# Se încarcă doar după ce vizitatorul acceptă cookie-urile; bannerul de acord apare automat
# când completezi măcar un cod. Tabelul din admin → Campanii funcționează și fără ele.
# Google Analytics 4: Admin → Fluxuri de date → ID-ul de măsurare (G-XXXXXXX).
GA_MEASUREMENT_ID=
# Google Ads: Obiective → Conversii → eticheta (AW-123456789 și eticheta fiecărei conversii).
GOOGLE_ADS_ID=
GOOGLE_ADS_BOOKING_LABEL=
GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook, Instagram): Events Manager → Surse de date → ID-ul pixelului (doar cifre).
META_PIXEL_ID=

# ── Opțional: Google Search Console și Bing Webmaster Tools ─────────────────
# Ca site-ul să apară și să fie urmărit în Google: adaugă domeniul în Search Console
# (https://search.google.com/search-console), alege verificarea prin „etichetă HTML” și copiază
# aici doar codul din content="…". La fel pentru Bing (msvalidate.01).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Backup ───────────────────────────────────────────────────────────────────
# Ora backup-ului zilnic (ora României) și câte zile se păstrează.
TZ=Europe/Bucharest
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

# ── Opțional: backup off-site cu rclone ─────────────────────────────────────
# Numele unei destinații configurate în rclone (ex. `b2:tenis-backup`).
# Lasă gol ca backup-urile să rămână doar pe server.
RCLONE_REMOTE=
