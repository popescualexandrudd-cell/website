# Hardware Bridge — copiați în /etc/jungle-bridge/bridge.env pe aparat (drepturi 600).
# Valorile reale NU intră niciodată în git.

# ID-ul aparatului din admin (Dispozitive) și tokenul afișat O SINGURĂ DATĂ la înrolare.
BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000
BRIDGE_DEVICE_TOKEN=
# Adresa API-ului clubului (o primește pagina chioșcului prin „hello”).
BRIDGE_API_URL=https://jungle-padel.ro/api/v1
# Originea aplicației chioșcului (numai ea se poate conecta la bridge); mai multe, separate prin virgulă.
BRIDGE_ALLOWED_ORIGINS=http://localhost:5174
# Cheia publică Ed25519 a serverului (base64) pentru comenzile de numerar (Etapa 8).
BRIDGE_SERVER_PUBLIC_KEY=
# Unde stau cheia bridge-ului și jurnalul de numerar (implicit /var/lib/jungle-bridge).
BRIDGE_DATA_DIR=/var/lib/jungle-bridge
BRIDGE_PORT=8765
BRIDGE_WINDOW_SECONDS=120
# Doar „simulator” până la alegerea aparatelor (Q23).
BRIDGE_DRIVERS=simulator
# 1 = pagina poate simula scanări, bancnote și defecte. DOAR în dezvoltare; 0 la club.
BRIDGE_SIMULATOR_CONTROL=0
