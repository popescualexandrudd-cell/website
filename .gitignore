# --- Secrets: never commit (only .env.example files are tracked) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.pkpass
*.crt
!deploy/**/ca-public/*.crt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / TypeScript ---
node_modules/
.pnpm-store/
.next/
out/
dist/
!packages/design-tokens/dist/
next-env.d.ts
build/
*.tsbuildinfo
.turbo/
coverage/
playwright-report/
test-results/
blob-report/

# --- Local runtime data ---
*.sqlite3
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
media/
# The site's hero video (ADR-0023) is served from apps/web/public/media/hero and committed; its
# original (media-src) and the tests' generated clip (hero-e2e) never are.
!apps/web/public/media/
apps/web/public/media/hero-e2e/
apps/web/media-src/*
!apps/web/media-src/hero/
apps/web/media-src/hero/*
!apps/web/media-src/hero/README.md
staticfiles/
/tmp/
*.log

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Tools downloaded by the scripts (scripts/test-deploy)
.cache/
